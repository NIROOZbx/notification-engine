# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to '.env' and fill in with your development or test credentials.
# DO NOT COMMIT YOUR COMPLETED '.env' FILE TO VERSION CONTROL.
# ==============================================================================

# ----------------------------------------------------
# 1. DATABASE CONFIGURATION
# ----------------------------------------------------
DB_NAME=notif_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_PORT=5432
DB_HOST=localhost

# ----------------------------------------------------
# 2. CACHE & SESSION STORE (REDIS)
# ----------------------------------------------------
REDIS_PASSWORD=your_redis_password_here
REDIS_ADDR=localhost:6379

# ----------------------------------------------------
# 3. KAFKA BROKER / CONCURRENCY PIPELINE
# ----------------------------------------------------
KAFKA_BROKER=localhost:9092
KAFKA_GROUP_ID=notification-engine-group

# ----------------------------------------------------
# 4. SECURITY & TOKENS (JWT & ENCRYPTION)
# ----------------------------------------------------
# Base64 or random string for signing JWT tokens
ACCESS_SECRET=your_jwt_access_token_secret_string
REFRESH_SECRET=your_jwt_refresh_token_secret_string

# 32-byte AES key for encrypting provider credentials at rest
CREDENTIALS_SECRET=your_32_byte_aes_decryption_key_here

# System Workspace and Environment UUIDs (Keep hidden)
SYSTEM_WORKSPACE_ID=your_system_workspace_uuid_here
SYSTEM_ENV_ID=your_system_environment_uuid_here

# ----------------------------------------------------
# 5. GOOGLE OAUTH CONFIGURATION
# ----------------------------------------------------
CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
CLIENT_SECRET=your_google_oauth_client_secret_here
REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# ----------------------------------------------------
# 6. PLATFORM MANAGEMENT PANEL (PGADMIN)
# ----------------------------------------------------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_pgadmin_password_here

# ----------------------------------------------------
# 7. SERVICE SETTINGS & DEFAULTS
# ----------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ----------------------------------------------------
# 8. ENGINE SYSTEM WORKSPACE / DEFAULT EMAIL ROUTER
# ----------------------------------------------------
SYSTEM_FROM_EMAIL=verify@notificationengine.com
SYSTEM_EMAIL_PROVIDER=mock # Options: mock, sendgrid, ses, resend
SYSTEM_EMAIL_API_KEY=your_outbound_provider_api_key_here
